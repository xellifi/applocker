rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // 1. RBAC Function
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin";
    }

    // 2. Pairing Sessions (Fixed 6-digit PIN)
    match /pairing_sessions/{code} {
      allow read, delete: if true;
      allow create: if request.auth != null;
    }
    
    // 3. Devices
    match /devices/{deviceId} {
      allow read, write: if true;

      // 7. Monitoring Activity Logs (under devices sub-collection)
      match /activity/{activityId} {
        allow read, write: if true;
      }

      // 8. Chat Messages (parent ↔ child)
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    // 4. Users (Includes Super Admin oversight)
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // 5. Subscription Plans (Required for dynamic management)
    match /plans/{planId} {
      allow read: if true; // Everyone can see available plans to subscribe
      allow write: if request.auth != null && isSuperAdmin(); // ONLY Super Admin can Add/Edit/Delete
    }
    
    // 6. Config Docs
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isSuperAdmin();
    }

    // 9. Payment Methods (Mode of Payment options like GCash, Maya, Bank Transfer)
    match /payment_methods/{methodId} {
      allow read: if true; // Anyone can view available payment methods
      allow write: if request.auth != null && isSuperAdmin(); // Only Super Admin can manage
    }

    // 10. Transactions (Payment submissions awaiting Super Admin approval)
    match /transactions/{transactionId} {
      allow create: if request.auth != null; // Any logged-in user can submit a payment
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update, delete: if request.auth != null && isSuperAdmin(); // Only Super Admin can approve/reject
    }
  }
}
